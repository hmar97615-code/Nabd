rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNotBanned() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(userPath) || get(userPath).data.get('banned', false) != true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && 
        ((exists(userPath) && get(userPath).data.get('role', 'user') == 'admin') ||
         (request.auth.token.email == "hmar97615@gmail.com" && request.auth.token.email_verified == true));
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'user';
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'banned'])) || isAdmin();
      allow delete: if isAdmin();
      
      // Daily Logs
      match /dailyLogs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // InBody Logs
      match /inBodyLogs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Workout Plans
      match /plans/{planId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Manual Training Plans
      match /manualPlans/{planId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Recipes
      match /recipes/{recipeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Chat History
      match /chatHistory/{chatId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Achievements
      match /achievements/{achId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Stats
      match /stats/{statId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Habits
      match /habits/{habitId} {
        allow read, write: if isOwner(userId) || isAdmin();
        
        // Completions
        match /completions/{completionId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }

    // Coach Profile Rules
    match /coaches/{coachId} {
      allow read: if true; // Publicly viewable
      allow write: if isOwner(coachId) || isAdmin();
    }

    // Connectivity Test Rule
    match /test/connection {
      allow read: if true;
    }
  }
}
